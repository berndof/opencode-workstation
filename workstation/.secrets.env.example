# OpenCode station secrets — EXAMPLE ONLY (all values intentionally empty).
#
# The REAL file is:
#     ~/.config/opencode/.secrets.env      (chmod 600 — never commit it)
#
# It is sourced by your shell startup files so that OpenCode sees the variables:
#     ~/.bashrc   ~/.zshrc   ~/.profile
# e.g. append:  [ -f "$HOME/.config/opencode/.secrets.env" ] && . "$HOME/.config/opencode/.secrets.env"
#
# Copy this example next to it, fill in the real values, then lock it down:
#     cp workstation/.secrets.env.example ~/.config/opencode/.secrets.env
#     chmod 600 ~/.config/opencode/.secrets.env
#
# Names only — no values belong in this repository.

# OmniRoute provider API key (providers.omni.settings.apiKey -> {env:OMNIROUTE_API_KEY})
OMNIROUTE_API_KEY=

# Cloudflare MCP bearer token (mcp.servers.cloudflare.headers.Authorization)
CLOUDFLARE_API_TOKEN=

# OmniRoute remote MCP bearer token (mcp.servers.omni-remoto.headers.Authorization)
OMNI_MCP_BEARER=
